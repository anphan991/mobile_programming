<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền gradient Deep Navy -> Royal Blue (xanh dương hài hòa) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#1E3A8A"
                android:endColor="#2563EB"
                android:startColor="#0A192F"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="42dp"
                android:bottomRightRadius="42dp" />
        </shape>
    </item>

    <!-- Ánh sáng Cyan góc trên phải -->
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="top|end"
        android:right="-70dp"
        android:top="-70dp">
        <shape android:shape="oval">
            <solid android:color="#2406B6D4" />
        </shape>
    </item>

    <!-- Ánh sáng Sky Blue góc trái dưới -->
    <item
        android:width="170dp"
        android:height="170dp"
        android:gravity="bottom|start"
        android:left="-50dp"
        android:bottom="16dp">
        <shape android:shape="oval">
            <solid android:color="#263B82F6" />
        </shape>
    </item>
</layer-list>
