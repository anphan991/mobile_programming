<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootProductList"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp"
    tools:ignore="HardcodedText,TextContrastCheck,TouchTargetSizeCheck">

    <!-- Thanh Header trên cùng -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:contentDescription="Mở hoặc đóng menu"
            android:focusable="true"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:padding="0dp"
            app:backgroundTint="@color/surface"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_menu_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/ink"
            app:strokeColor="@color/border_strong"
            app:strokeWidth="1dp"
            tools:ignore="TouchTargetSizeCheck" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sản phẩm"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Danh mục thiết bị công nghệ"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Nút mở giỏ hàng ở góc trên bên phải -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenCart"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="Mở giỏ hàng"
                android:focusable="true"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0dp"
                app:backgroundTint="@color/surface"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_cart_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="20dp"
                app:iconTint="@color/ink"
                app:strokeColor="@color/border_strong"
                app:strokeWidth="1dp"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/tvHeaderCartBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_cart_badge"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Thanh Menu ẩn hiện (Collapsible Menu Panel) -->
    <LinearLayout
        android:id="@+id/layoutMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_surface"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="ĐIỀU HƯỚNG &amp; BỘ LỌC"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMenuAccountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_primary"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="Tài khoản: admin"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/menuHome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Tất cả sản phẩm"
            android:textColor="@color/primary_dark"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuFilterMobile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Điện thoại &amp; Máy tính bảng"
            android:textColor="@color/ink"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/menuFilterAudio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Thiết bị âm thanh (Tai nghe, Loa)"
            android:textColor="@color/ink"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/menuFilterAccessory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Laptop &amp; Phụ kiện công nghệ"
            android:textColor="@color/ink"
            android:textSize="13.5sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/menuProfile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Hồ sơ cá nhân"
            android:textColor="@color/ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuCart"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Giỏ hàng &amp; Đặt mua"
            android:textColor="@color/ink"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/menuInfo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Thông tin ứng dụng"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/menuLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Đăng xuất"
            android:textColor="@color/danger"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Thanh thông tin tài khoản và bộ đếm sản phẩm -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWelcomeUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xin chào, khách"
            android:textColor="@color/ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProductCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 sản phẩm"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Danh sách sản phẩm -->
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:paddingBottom="4dp"
        android:scrollbars="none" />

    <!-- Thanh điều hướng phân trang Back / Next ở dưới cùng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="Trang trước"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/surface_subtle"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_arrow_left_24"
            app:iconGravity="textStart"
            app:iconPadding="5dp"
            app:iconSize="15dp"
            app:iconTint="@color/ink"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp"
            tools:ignore="TouchTargetSizeCheck" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="0.75"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="TRANG"
                android:textColor="@color/text_tertiary"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="1 / 2"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="Trang tiếp"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_arrow_right_24"
            app:iconGravity="textEnd"
            app:iconPadding="5dp"
            app:iconSize="15dp"
            app:iconTint="@color/white"
            tools:ignore="TouchTargetSizeCheck" />
    </LinearLayout>

</LinearLayout>
