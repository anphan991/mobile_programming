<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="26dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp"
    tools:ignore="HardcodedText,TouchTargetSizeCheck">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    app:cardBackgroundColor="@color/accent_amber_soft"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Đánh giá sao"
                        android:src="@drawable/ic_star_filled_24" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvWriteReviewTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đánh giá sản phẩm"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWriteReviewSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Chia sẻ trải nghiệm thực tế của bạn"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hàng chọn 5 ngôi sao tương tác -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_spec_box"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/starPick1"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="1 sao"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_star_filled_24" />

                    <ImageView
                        android:id="@+id/starPick2"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="2 sao"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_star_filled_24" />

                    <ImageView
                        android:id="@+id/starPick3"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="3 sao"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_star_filled_24" />

                    <ImageView
                        android:id="@+id/starPick4"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="4 sao"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_star_filled_24" />

                    <ImageView
                        android:id="@+id/starPick5"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:clickable="true"
                        android:contentDescription="5 sao"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_star_filled_24" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPickedStarLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="5 sao - Cực kỳ hài lòng"
                    android:textColor="#B45309"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nhãn gợi ý chọn nhanh -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.05"
                android:text="CHỌN NHANH ĐIỂM NỔI BẬT"
                android:textColor="@color/primary_dark"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupReviewTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="2dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTagAuthentic"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="Hàng chính hãng"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="11.5sp"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="16dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTagPerformance"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Hiệu năng đỉnh"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="11.5sp"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="16dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTagFast"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Giao hàng nhanh"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="11.5sp"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="16dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTagWorth"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Rất đáng tiền"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="11.5sp"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipCornerRadius="16dp" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReviewComment"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Nhập nhận xét chi tiết về sản phẩm..."
                app:boxBackgroundColor="#F8FAFC"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtReviewComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minLines="3"
                    android:textColor="@color/ink"
                    android:textSize="13.5sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelReview"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="Đóng"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/border_strong"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitReview"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.3"
                    android:minHeight="48dp"
                    android:text="Gửi đánh giá"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="14dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
