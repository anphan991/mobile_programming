<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền gradient Midnight Obsidian -> Electric Indigo -> Royal Blue -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#1E1B4B"
                android:endColor="#2563EB"
                android:startColor="#090D16"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="44dp"
                android:bottomRightRadius="44dp" />
        </shape>
    </item>

    <!-- Ánh sáng Neon Cyan góc trên phải -->
    <item
        android:width="250dp"
        android:height="250dp"
        android:gravity="top|end"
        android:right="-75dp"
        android:top="-75dp">
        <shape android:shape="oval">
            <solid android:color="#2E06B6D4" />
        </shape>
    </item>

    <!-- Ánh sáng Electric Indigo góc trái dưới -->
    <item
        android:width="180dp"
        android:height="180dp"
        android:bottom="14dp"
        android:gravity="bottom|start"
        android:left="-55dp">
        <shape android:shape="oval">
            <solid android:color="#336366F1" />
        </shape>
    </item>
</layer-list>
