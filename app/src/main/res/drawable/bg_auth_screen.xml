<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nền tổng thể xám xanh dịu -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F1F5F9" />
        </shape>
    </item>

    <!-- Khối gradient cong phía trên -->
    <item
        android:height="320dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#3B82F6"
                android:startColor="#1E3A8A"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="36dp"
                android:bottomRightRadius="36dp" />
        </shape>
    </item>

    <!-- Vòng tròn trang trí mờ góc trên phải -->
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="top|end"
        android:right="-60dp"
        android:top="-60dp">
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- Vòng tròn trang trí mờ góc trái -->
    <item
        android:width="140dp"
        android:height="140dp"
        android:gravity="top|start"
        android:left="-40dp"
        android:top="130dp">
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
