<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#1E3A8A"
                android:endColor="#2563EB"
                android:startColor="#0B1120"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#3393C5FD" />
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="top|end"
        android:right="-35dp"
        android:top="-40dp">
        <shape android:shape="oval">
            <solid android:color="#2E06B6D4" />
        </shape>
    </item>
    <item
        android:width="110dp"
        android:height="110dp"
        android:bottom="-35dp"
        android:gravity="bottom|start"
        android:left="-25dp">
        <shape android:shape="oval">
            <solid android:color="#266366F1" />
        </shape>
    </item>
</layer-list>
